{
  "name": "open-higgsfield",
  "version": "0.2.0",
  "private": true,
  "description": "Highfield creative studio: a self-hosted open-higgsfield fork with direct cloud providers and local planning engines.",
  "license": "MIT",
  "author": "TechBe",
  "homepage": "https://github.com/helloworldxdwastaken/open-higgsfield",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helloworldxdwastaken/open-higgsfield.git"
  },
  "bugs": {
    "url": "https://github.com/helloworldxdwastaken/open-higgsfield/issues"
  },
  "keywords": [
    "ai-image-generator",
    "ai-video-generator",
    "generative-ai",
    "higgsfield",
    "higgsfield-alternative",
    "open-higgsfield",
    "gemini",
    "vertex-ai",
    "vercel-ai-gateway",
    "freepik-api",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:director": "node tests/director.cjs",
    "test:contracts": "node tests/director.cjs && node tests/task-store.cjs && node tests/providers.cjs && node tests/model-settings.cjs && node tests/provider-route.cjs && node tests/user-storage.cjs && node tests/public-tasks.cjs && node tests/public-error.cjs && node tests/cinema-store.cjs && node tests/cinema-service.cjs && node tests/skills.cjs && node tests/skill-reference.cjs && node tests/effect-presets.cjs",
    "privacy:check": "node scripts/check-public-source.mjs",
    "privacy:history": "node scripts/check-public-source.mjs --history",
    "test:privacy": "node tests/public-tasks.cjs && node tests/public-error.cjs && node tests/source-privacy.mjs",
    "test:cinema": "node tests/cinema-store.cjs && node tests/cinema-service.cjs",
    "test:skills": "node tests/skills.cjs && node tests/skill-reference.cjs",
    "sources:skills": "node scripts/build-skill-reference.mjs",
    "test:presets": "node tests/effect-presets.cjs",
    "cache:presets": "node scripts/cache-preset-previews.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.71",
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.20.0",
    "@hookform/resolvers": "^5.9.1",
    "ai": "^7.0.89",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.39.0",
    "mime-types": "^3.0.2",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "sharp": "^0.35.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/formidable": "^3.5.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
