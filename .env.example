# Freepik
FREEPIK_API_KEY=

# Google AI Studio (GEMINI_API_KEY is the preferred name)
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS, or
# provide the service-account JSON inline in one of these variables:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_CREDENTIALS=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Optional PostgreSQL / Neon persistence for task history and generated images
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Temporary public hosting for input media
CLOUDINARY_URL=
# Or configure the three values below instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional local runtime storage directory.
# Used as a local fallback. Vercel automatically uses /tmp/open-higgsfield.
# OPEN_HIGGSFIELD_STORAGE_DIR=/absolute/path/to/open-higgsfield-data

# Highfield public origin (required for saving provider connections)
STUDIO_PUBLIC_ORIGIN=http://localhost:3000
# Private speech engine for the integrated VoiceLab tab (contract in docs/audio.md). Never expose this listener publicly.
HIGHFIELD_VOICEBOX_URL=http://127.0.0.1:7883
# Private credentials directory; never commit runtime files
# STUDIO_SETTINGS_DIR=/absolute/private-settings

# Additional direct media providers
OPENROUTER_API_KEY=
# Complete Higgsfield API credentials in id:secret format
HF_CREDENTIALS=

# Local planning engines: private/loopback HTTP(S) base URL, no API path
LM_STUDIO_URL=
LM_STUDIO_API_KEY=
OLLAMA_URL=
# Draw Things HTTP image engine, when enabled in Draw Things
DRAW_THINGS_URL=
